    <!-- Скрипт перевірки наявності активної чернетки та профілю -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const saved = localStorage.getItem('smarttest_draft');
                const banner = document.getElementById('quickDraftBanner');
                const titleEl = document.getElementById('quickDraftTitle');
                if (saved) {
                    const data = JSON.parse(saved);
                    if (banner && data && data.title) {
                        if (titleEl) titleEl.textContent = data.title;
                        banner.style.display = 'flex';
                    }
                } else {
                    if (banner) banner.style.display = 'none';
                }
            } catch (e) {
                console.log(e);
            }

            // Оновлення статусу кнопки входу в шапці
            try {
                const userRaw = localStorage.getItem('smarttest_user');
                if (userRaw) {
                    const user = JSON.parse(userRaw);
                    const btn = document.querySelector('.btn-login span');
                    if (btn && user.nickname) btn.textContent = '@@' + user.nickname;
                }
            } catch (e) {}
        });
    </script>

