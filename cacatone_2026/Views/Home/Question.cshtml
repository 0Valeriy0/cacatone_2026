@* 
    SmartTest — Сторінка відображення ситуаційних кейсів / питань
    Чистий Razor (.cshtml) + CSS
*@
@{
    Layout = null;
    ViewData["Title"] = "SmartTest — Ситуаційний кейс профілювання";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Багатовимірне AI-профілювання. Ситуаційний кейс з оцінкою векторів вибору." />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Стилі -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body class="assessment-page">

    <!-- Верхня панель проходження тесту (Прогрес-бар + Навігація) -->
    <header class="assessment-topbar">
        <div class="container assessment-topbar-inner">
            
            <!-- Посилання назад на головну -->
            <a href="/" class="assessment-back-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Вийти з матриці</span>
            </a>

            <!-- Центральний прогрес-бар -->
            <div class="progress-center">
                <div class="progress-meta">
                    <span id="questionProgressMeta">Кейс 1 з 8 • Командна взаємодія & Менторство</span>
                    <span class="text-accent" id="questionProgressPercent">13% пройдено</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" id="questionProgressFill" style="width: 13%;"></div>
                </div>
            </div>

            <!-- Бейдж темпу AI -->
            <div class="assessment-tempo-badge">
                <span class="pulse-dot"></span>
                <span>AI калібрує ваги</span>
            </div>

        </div>
    </header>

    <!-- Банер активної авторської матриці -->
    <div id="customMatrixBanner" style="display: none; background: #faf5ff; border-bottom: 1.5px solid #e9d5ff; padding: 10px 0;">
        <div class="container" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #8a00c2;">
                <span style="font-size: 16px;">✨</span>
                <span>Ви проходите авторську матрицю: <strong id="customMatrixTitleText" style="color: #0f172a;"></strong></span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/create" style="font-size: 12px; color: #8a00c2; text-decoration: none; font-weight: 700; background: #ffffff; padding: 4px 12px; border-radius: 9999px; border: 1px solid #e4b6ff;">✏️ Редагувати в конструкторі</a>
                <button type="button" onclick="resetToDefaultMatrix()" style="background: none; border: none; font-size: 12px; color: #64748b; cursor: pointer; text-decoration: underline; font-weight: 600;">Скинути до стандартного</button>
            </div>
        </div>
    </div>

    <!-- Основна робоча зона тесту -->
    <main class="assessment-main">
        <div class="container">
            <div class="assessment-grid">
                
                <!-- Ліва колонка: Ситуаційний кейс та варіанти -->
                <div class="assessment-content-col">
                    
                    <!-- Картка ситуаційного кейсу -->
                    <div class="dilemma-card">
                        <div class="dilemma-meta-row">
                            <span class="category-tag" id="questionCategory">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
                                </svg>
                                <span id="categoryLabelText">Командна взаємодія & Менторство</span>
                            </span>
                            <span class="no-right-answers-pill">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                Немає правильних відповідей
                            </span>
                        </div>

                        <h1 class="dilemma-title" id="questionTitle">
                            Новий інженер соромиться ставити питання і блокує свій прогрес. Ваші дії?
                        </h1>

                        <p class="dilemma-context" id="questionContext">
                            Джуніор-спеціаліст уже другий день сидить над задачею без відчутного прогресу, намагаючись усе розібрати самостійно. Через це весь спринт під загрозою зриву. Як ви побудуєте взаємодію у цій ситуації?
                        </p>
                    </div>

                    <!-- Заголовок блоку вибору -->
                    <div class="choices-heading">
                        Оберіть вашу природну лінію поведінки:
                    </div>

                    <!-- Список 4 стратегій (Варіанти відповіді) -->
                    <div class="choices-stack" id="choicesList">
                        <!-- Динамічно рендериться скриптом -->
                    </div>

                    <!-- Нижня панель навігації між питаннями -->
                    <div class="assessment-nav-bar">
                        <!-- Кнопка "Попередній кейс" -->
                        <button type="button" class="btn-nav-prev" id="btnPrevQuestion" onclick="prevQuestion()" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            <span>Попередній кейс</span>
                        </button>

                        <div id="saveStatusIndicator" style="font-size: 12px; color: #94a3b8; font-weight: 500;">
                            💾 Відповідь збережено
                        </div>

                        <!-- Контейнер переходу вперед: "Наступне питання" (якщо не останнє) або "Завершити" (якщо останнє) -->
                        <div id="nextActionContainer">
                            <!-- Кнопка "Наступне питання": відображається, якщо це питання НЕ останнє -->
                            <button type="button" id="btnNextQuestion" class="btn-nav-next" onclick="nextQuestion()">
                                <span>Наступне питання</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>

                            <!-- Кнопка "Завершити": відображається ТІЛЬКИ на останньому питанні -->
                            <button type="button" id="btnFinishTest" class="btn-nav-next" onclick="finishAndAnalyzeTest()" style="display: none; border: none; cursor: pointer; text-decoration: none; background: linear-gradient(135deg, #8a00c2 0%, #680099 100%);">
                                <span>Завершити та переглянути AI-вердикт</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>

                </div>

                <!-- Права колонка: AI-сенсор у реальному часі -->
                <aside class="ai-sensor-col">
                    <div class="ai-sensor-card">
                        
                        <div class="ai-sensor-header">
                            <div class="ai-sensor-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            </div>
                            <div>
                                <div class="ai-sensor-title">AI-сенсор векторів</div>
                                <div class="ai-sensor-sub" id="sensorArchetype">Поточний фокус: Емпатичний Ментор</div>
                            </div>
                        </div>

                        <!-- Мініатюрний живий спайдер-чарт -->
                        <div class="mini-radar-box">
                            <svg viewBox="0 0 100 100" style="width: 100%; height: 100%; transform: rotate(-90deg);">
                                <!-- Сітка -->
                                <polygon points="50,15 85,38 72,78 28,78 15,38" fill="none" stroke="#e2e8f0" stroke-width="1"></polygon>
                                <polygon points="50,25 74,42 65,70 35,70 26,42" fill="none" stroke="#e2e8f0" stroke-width="1"></polygon>
                                <polygon points="50,35 63,46 58,62 42,62 37,46" fill="none" stroke="#e2e8f0" stroke-width="1"></polygon>
                                
                                <line x1="50" y1="50" x2="50" y2="15" stroke="#cbd5e1" stroke-width="0.8" stroke-dasharray="2"></line>
                                <line x1="50" y1="50" x2="85" y2="38" stroke="#cbd5e1" stroke-width="0.8" stroke-dasharray="2"></line>
                                <line x1="50" y1="50" x2="72" y2="78" stroke="#cbd5e1" stroke-width="0.8" stroke-dasharray="2"></line>
                                <line x1="50" y1="50" x2="28" y2="78" stroke="#cbd5e1" stroke-width="0.8" stroke-dasharray="2"></line>
                                <line x1="50" y1="50" x2="15" y2="38" stroke="#cbd5e1" stroke-width="0.8" stroke-dasharray="2"></line>
                                
                                <!-- Динамічний полігон -->
                                <polygon id="liveRadarPolygon" points="50,18 68,45 60,70 30,75 16,36" fill="rgba(138, 0, 194, 0.22)" stroke="#8a00c2" stroke-width="2" style="transition: all 0.4s ease-out;"></polygon>
                            </svg>
                            <div style="position: absolute; font-size: 9px; font-weight: 800; color: #8a00c2; background: #ffffff; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                                РАДАР СКІЛІВ
                            </div>
                        </div>

                        <!-- Поточні розраховані показники -->
                        <div class="live-vector-stats">
                            <div class="vector-stat-row">
                                <span class="vector-stat-name">Кризове лідерство</span>
                                <span class="vector-stat-val" id="statLeadership">72%</span>
                            </div>
                            <div class="vector-stat-row">
                                <span class="vector-stat-name">Логіка & Безпека</span>
                                <span class="vector-stat-val" id="statLogic">68%</span>
                            </div>
                            <div class="vector-stat-row">
                                <span class="vector-stat-name">Адаптивність</span>
                                <span class="vector-stat-val" id="statAdaptability">84%</span>
                            </div>
                            <div class="vector-stat-row">
                                <span class="vector-stat-name">Емпатія & Менторство</span>
                                <span class="vector-stat-val" id="statEmpathy">92%</span>
                            </div>
                        </div>

                        <div class="ai-sensor-hint">
                            💡 ШІ аналізує узгодженість ваших реакцій та формує багатовимірний профіль без жодних суб'єктивних упереджень.
                        </div>

                    </div>
                </aside>

            </div>
        </div>
    </main>

    <!-- База питань та інтерактивна логіка перемикання кейсів -->
    <script>
        // Базова конфігурація кейсів тесту
        const defaultQuestionsData = [
