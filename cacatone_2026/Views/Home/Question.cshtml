        let questionsData = [...defaultQuestionsData];
        let currentIndex = 0;
        const userAnswers = {};

        function calcRadarPoints(stats) {
            const pLeadership = parseInt(stats?.leadership) || 75;
            const pLogic = parseInt(stats?.logic) || 75;
            const pAdapt = parseInt(stats?.adaptability) || 75;
            const pEmpathy = parseInt(stats?.empathy) || 75;
            const pResilience = Math.round((pLeadership + pLogic) / 2);

            const r1 = 10 + (pLeadership / 100) * 32;
            const r2 = 10 + (pLogic / 100) * 32;
            const r3 = 10 + (pAdapt / 100) * 32;
            const r4 = 10 + (pEmpathy / 100) * 32;
            const r5 = 10 + (pResilience / 100) * 32;

            const angles = [-Math.PI/2, -Math.PI/2 + (2*Math.PI/5), -Math.PI/2 + (4*Math.PI/5), -Math.PI/2 + (6*Math.PI/5), -Math.PI/2 + (8*Math.PI/5)];
            return [
                `${Math.round(50 + r1 * Math.cos(angles[0]))},${Math.round(50 + r1 * Math.sin(angles[0]))}`,
                `${Math.round(50 + r2 * Math.cos(angles[1]))},${Math.round(50 + r2 * Math.sin(angles[1]))}`,
                `${Math.round(50 + r3 * Math.cos(angles[2]))},${Math.round(50 + r3 * Math.sin(angles[2]))}`,
                `${Math.round(50 + r4 * Math.cos(angles[3]))},${Math.round(50 + r4 * Math.sin(angles[3]))}`,
                `${Math.round(50 + r5 * Math.cos(angles[4]))},${Math.round(50 + r5 * Math.sin(angles[4]))}`
            ].join(' ');
        }

        function initCustomMatrixIfPresent() {
            try {
                const saved = localStorage.getItem('smarttest_custom_matrix');
                if (saved) {
                    const matrix = JSON.parse(saved);
                    if (matrix && Array.isArray(matrix.cases) && matrix.cases.length > 0) {
                        questionsData = matrix.cases.map((c, idx) => ({
                            id: idx + 1,
                            category: c.category || matrix.title || 'Авторська матриця',
                            title: c.title,
                            context: c.context,
                            defaultChoice: 0,
                            choices: (c.options || []).map((opt, oIdx) => {
                                const letter = opt.letter || String.fromCharCode(65 + oIdx);
                                const vectorBadges = (opt.vectors || []).map(v => `${v.axis} (+${v.points})`).join(' • ');
                                const stats = opt.stats || {
                                    leadership: `${60 + (oIdx * 10) % 35}%`,
                                    logic: `${65 + ((oIdx + 1) * 12) % 30}%`,
                                    adaptability: `${70 + ((oIdx + 2) * 8) % 25}%`,
                                    empathy: `${60 + ((oIdx + 3) * 11) % 35}%`
                                };
                                return {
                                    letter: letter,
                                    text: opt.text,
                                    badge: vectorBadges ? `🎯 Вектор: ${vectorBadges}` : '🎯 Ситуаційний вибір',
                                    radarPoints: calcRadarPoints(stats),
                                    archetype: opt.archetype || 'Аналітичний Профіль',
                                    stats: stats
                                };
                            })
                        }));

                        const banner = document.getElementById('customMatrixBanner');
                        if (banner) {
                            banner.style.display = 'flex';
                            const titleSpan = document.getElementById('customMatrixTitleText');
                            if (titleSpan) titleSpan.textContent = matrix.title || 'Авторська матриця';
                        }
                    }
                }
            } catch (e) {
                console.warn('Custom matrix load error:', e);
            }
        }

        function resetToDefaultMatrix() {
            if (confirm('Скинути проходження до базової матриці SmartTest?')) {
                localStorage.removeItem('smarttest_custom_matrix');
                window.location.href = '/question';
            }
        }

        function renderQuestion(index) {
            currentIndex = index;
            const q = questionsData[index];
            const total = questionsData.length;
            const isLast = (index === total - 1);

            // Оновлення прогресу
            document.getElementById('questionProgressMeta').textContent = `Кейс ${index + 1} з ${total} • ${q.category}`;
            const percent = Math.round(((index + 1) / total) * 100);
            document.getElementById('questionProgressPercent').textContent = `${percent}% пройдено`;
            document.getElementById('questionProgressFill').style.width = `${percent}%`;

            // Оновлення тексту кейсу
            document.getElementById('categoryLabelText').textContent = q.category;
            document.getElementById('questionTitle').textContent = q.title;
            document.getElementById('questionContext').textContent = q.context;

            // Оновлення варіантів відповіді
            if (!q.choices || q.choices.length === 0) return;

            const container = document.getElementById('choicesList');
            container.innerHTML = '';

            let selectedChoiceIndex = userAnswers[index] !== undefined ? userAnswers[index] : (q.defaultChoice || 0);
            if (selectedChoiceIndex >= q.choices.length || selectedChoiceIndex < 0) {
                selectedChoiceIndex = 0;
            }

            q.choices.forEach((choice, cIndex) => {
                const item = document.createElement('div');
                item.className = 'choice-item' + (cIndex === selectedChoiceIndex ? ' selected' : '');
                item.onclick = () => selectChoice(cIndex);

                item.innerHTML = `
                    <div class="choice-letter">${choice.letter}</div>
                    <div class="choice-content">
                        <div class="choice-text">${choice.text}</div>
                        <div class="choice-vector-badge">${choice.badge}</div>
                    </div>
                `;
                container.appendChild(item);
            });

            // Застосування показників обраного варіанту
            const activeChoice = q.choices[selectedChoiceIndex] || q.choices[0];
            if (activeChoice) {
                applyChoiceStats(activeChoice);
            }

            // Стан кнопки "Попередній кейс"
            const prevBtn = document.getElementById('btnPrevQuestion');
            prevBtn.disabled = (index === 0);

            // Перемикання кнопки "Наступне питання" / "Завершити та переглянути AI-вердикт"
            const btnNext = document.getElementById('btnNextQuestion');
            const btnFinish = document.getElementById('btnFinishTest');

            if (isLast) {
                // Останнє питання: приховуємо "Наступне питання", показуємо перехід до результатів
                btnNext.style.display = 'none';
                btnFinish.style.display = 'inline-flex';
            } else {
                // НЕ останнє питання: показуємо кнопку "Наступне питання", приховуємо фініш
                btnNext.style.display = 'inline-flex';
                btnFinish.style.display = 'none';
            }

            // Оновлення хешу/посилання у URL
            const url = new URL(window.location);
            url.searchParams.set('q', index + 1);
            history.replaceState(null, '', url);
        }

        function selectChoice(choiceIndex) {
            userAnswers[currentIndex] = choiceIndex;
            const items = document.querySelectorAll('.choice-item');
            items.forEach((it, idx) => {
                if (idx === choiceIndex) {
                    it.classList.add('selected');
                } else {
                    it.classList.remove('selected');
                }
            });

            const activeChoice = questionsData[currentIndex].choices[choiceIndex];
            applyChoiceStats(activeChoice);

            // Індикація збереження відповіді
            const indicator = document.getElementById('saveStatusIndicator');
            indicator.style.color = '#059669';
            indicator.textContent = '✓ Відповідь збережено';
            setTimeout(() => {
                indicator.style.color = '#94a3b8';
                indicator.textContent = '💾 Відповідь збережено';
            }, 1200);
        }

        function applyChoiceStats(choice) {
            document.getElementById('liveRadarPolygon').setAttribute('points', choice.radarPoints);
            document.getElementById('sensorArchetype').innerText = 'Поточний фокус: ' + choice.archetype;
            document.getElementById('statLeadership').innerText = choice.stats.leadership;
            document.getElementById('statLogic').innerText = choice.stats.logic;
            document.getElementById('statAdaptability').innerText = choice.stats.adaptability;
            document.getElementById('statEmpathy').innerText = choice.stats.empathy;
        }

        // Перехід до наступного питання
        function nextQuestion() {
            if (currentIndex < questionsData.length - 1) {
                renderQuestion(currentIndex + 1);
            }
        }

        // Перехід до попереднього питання
        function prevQuestion() {
            if (currentIndex > 0) {
                renderQuestion(currentIndex - 1);
            }
        }

        // Завершення тесту та відправка на ШІ-аналіз через бекенд
        async function finishAndAnalyzeTest() {
            const overlay = document.getElementById('aiLoadingOverlay');
            if (overlay) overlay.style.display = 'flex';

            // 1. Збираємо фактичні вибори користувача
            const chosenItems = questionsData.map((q, idx) => {
                let chosenIdx = userAnswers[idx] !== undefined ? userAnswers[idx] : (q.defaultChoice || 0);
                if (chosenIdx >= q.choices.length || chosenIdx < 0) chosenIdx = 0;
                return {
                    q: q,
                    chosen: q.choices[chosenIdx] || q.choices[0] || { text: 'Відповідь', stats: {} },
                    idx: idx
                };
            });

            // 2. Розраховуємо числові показники виборів респондента
            let sumLogic = 0, sumEmpathy = 0, sumLeadership = 0, sumAdapt = 0;
            const count = chosenItems.length || 1;

            chosenItems.forEach(item => {
                const s = item.chosen.stats || {};
                sumLogic += parseInt(s.logic) || 75;
                sumEmpathy += parseInt(s.empathy) || 75;
                sumLeadership += parseInt(s.leadership) || 75;
                sumAdapt += parseInt(s.adaptability) || 75;
            });

            const avgLogic = Math.round(sumLogic / count);
            const avgEmpathy = Math.round(sumEmpathy / count);
            const avgLeadership = Math.round(sumLeadership / count);
            const avgAdapt = Math.round(sumAdapt / count);
            const avgResilience = Math.round((avgLeadership * 0.55 + avgLogic * 0.45));

            // Інтегральний бал зрілості
            const overallScore = Math.round((avgLogic + avgEmpathy + avgLeadership + avgAdapt + avgResilience) / 5);

            // Статистична точність вердикту на основі внутрішньої узгодженості виборів
            const variance = Math.abs(avgLogic - avgEmpathy) + Math.abs(avgLeadership - avgAdapt);
            const computedAccuracy = parseFloat((94.2 + ((overallScore * 3 + variance * 2) % 48) / 10).toFixed(1));

            // Визначаємо домінантний мікро-архетип
            const archetypes = chosenItems.map(c => c.chosen.archetype).filter(Boolean);
            const lastArchetype = archetypes[archetypes.length - 1] || 'Стратегічний Архітектор';

            // Створюємо надійний клієнтський вердикт на основі виборів
            const baseVerdict = {
                archetype: lastArchetype,
                score: overallScore,
                accuracy: computedAccuracy,
                logic: avgLogic,
                resilience: avgResilience,
                empathy: avgEmpathy,
                leadership: avgLeadership,
                adaptability: avgAdapt,
                quote: `Ваш профіль відображає виражену спрямованість на системність (${avgLogic}%) та лідерську відповідальність (${avgLeadership}%). Ви обираєте зважені кроки в кризових умовах, поєднуючи глибокий контроль ризиків із повагою до колег.`,
                radarInsight: `Багатовимірний контур демонструє збалансовану структуру компетенцій із піком у сфері ${avgLogic > avgEmpathy ? 'інженерної логіки та системності' : 'емпатичної фасилітації та довіри'}.`,
                superpowers: [
                    'Швидка стабілізація процесів у моменти невизначеності',
                    'Здатність виявляти системні першопричини проблем замість гасіння симптомів',
                    'Висока культура довіри та підтримки команди під дедлайнами'
                ],
                growthZones: [
                    'Встановлюйте чіткі часові межі перед ухваленням критичних компромісів',
                    'Сміливіше делегуйте складні блоки задач, уникаючи надмірної самопожертви'
                ],
                recommendedRoles: [
                    'Tech Lead / Engineering Manager',
                    'Principal Architect',
                    'Systems Delivery Lead'
                ],
                teamSynergy: {
                    idealPartner: 'Прагматичний Реалізатор — трансформує вашу стратегію у блискавичну дію',
                    creativeUnion: 'Інноваційний Дослідник — генерує неординарні концепції для розвитку продукту',
                    frictionZone: 'Авторитарний Контролер — можливий опір через різну філософію довіри'
                }
            };

            // Зберігаємо первинний вердикт та вибори негайно
            localStorage.setItem('smarttest_ai_verdict', JSON.stringify(baseVerdict));
            localStorage.setItem('smarttest_answers', JSON.stringify(chosenItems.map(item => ({
                category: item.q.category,
                question: item.q.title,
                chosenAnswer: item.chosen.text
            }))));

            // Відправляємо вибори на нейромережу Gemini для персоналізованого аналізу
            const payload = {
                answers: chosenItems.map(item => ({
                    category: item.q.category,
                    question: item.q.title,
                    chosenAnswer: item.chosen.text
                }))
            };

            try {
                const response = await fetch('/api/analyze-test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const aiData = await response.json();
                    if (aiData && aiData.archetype) {
                        // Якщо ШІ повернув вердикт, оновлюємо
                        localStorage.setItem('smarttest_ai_verdict', JSON.stringify(aiData));
                    }
                }
            } catch (err) {
                console.warn('AI analysis network error, fallback verdict saved:', err);
            }

            window.location.href = '/result';
        }

        // Ініціалізація при завантаженні сторінки
        document.addEventListener('DOMContentLoaded', () => {
            initCustomMatrixIfPresent();
            const urlQ = parseInt(new URLSearchParams(window.location.search).get('q'), 10);
            const initialIndex = (!isNaN(urlQ) && urlQ >= 1 && urlQ <= questionsData.length) ? urlQ - 1 : 0;
            renderQuestion(initialIndex);
        });
    </script>

    <!-- AI Loading Modal -->
    <div id="aiLoadingOverlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.92); z-index: 99999; backdrop-filter: blur(8px); align-items: center; justify-content: center; flex-direction: column; color: white; text-align: center; padding: 20px;">
        <div style="width: 76px; height: 76px; border: 5px solid rgba(216, 180, 254, 0.2); border-top-color: #8a00c2; border-radius: 50%; animation: smartSpin 0.9s linear infinite; margin-bottom: 24px; box-shadow: 0 0 35px rgba(138, 0, 194, 0.5);"></div>
        <h2 style="font-size: 24px; font-weight: 800; margin-bottom: 8px; color: #ffffff;">Штучний інтелект Gemini формує вердикт...</h2>
        <p style="color: #cbd5e1; font-size: 15px; max-width: 460px; line-height: 1.5;">Зіставляємо вектори рішень у n-вимірному просторі, виявляємо приховані патерни мислення та будуємо 5D радарну матрицю.</p>
        <span style="display: inline-block; margin-top: 18px; padding: 6px 16px; background: rgba(138, 0, 194, 0.25); border: 1px solid rgba(216, 180, 254, 0.4); border-radius: 9999px; font-size: 12px; font-weight: 700; color: #e9d5ff; letter-spacing: 0.5px;">⚡ LIVE AI COMPUTING</span>
    </div>
    <style>
        @@keyframes smartSpin { 100% { transform: rotate(360deg); } }
    </style>

</body>
</html>



