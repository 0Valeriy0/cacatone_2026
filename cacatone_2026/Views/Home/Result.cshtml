    <!-- Скрипт динамічного заповнення AI-вердикту від Gemini -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const raw = localStorage.getItem('smarttest_ai_verdict');
            if (!raw) {
                const demoBanner = document.getElementById('demoNoticeBanner');
                if (demoBanner) demoBanner.style.display = 'flex';
                const badge = document.getElementById('verdictBadgeText');
                if (badge) badge.innerHTML = 'ДЕМОНСТРАЦІЙНИЙ ЗРАЗОК • ТОЧНІСТЬ ВЕРДИКТУ <span id="verdictAccuracyVal">97.2%</span>';
                return;
            }

            try {
                const verdict = JSON.parse(raw);

                // 1. Архетип та оцінка
                if (verdict.archetype) {
                    const elName = document.getElementById('verdictArchetypeName');
                    if (elName) elName.textContent = verdict.archetype;
                }
                if (verdict.score) {
                    const elScore = document.getElementById('verdictArchetypeScore');
                    if (elScore) elScore.textContent = verdict.score + '%';
                }
                if (verdict.quote) {
                    const elQuote = document.getElementById('verdictArchetypeQuote');
                    if (elQuote) elQuote.textContent = '«' + verdict.quote + '»';
                }

                // 2. Виміри (шкали прогресу)
                const dims = [
                    { key: 'logic', valId: 'valLogic', barId: 'barLogic' },
                    { key: 'resilience', valId: 'valResilience', barId: 'barResilience' },
                    { key: 'empathy', valId: 'valEmpathy', barId: 'barEmpathy' },
                    { key: 'leadership', valId: 'valLeadership', barId: 'barLeadership' },
                    { key: 'adaptability', valId: 'valAdaptability', barId: 'barAdaptability' }
                ];

                dims.forEach(d => {
                    const score = verdict[d.key];
                    if (score !== undefined) {
                        const valEl = document.getElementById(d.valId);
                        const barEl = document.getElementById(d.barId);
                        if (valEl) valEl.textContent = score + '%';
                        if (barEl) barEl.style.width = score + '%';
                    }
                });

                // 3. Динамічний перерахунок точок Радарного полігону (Spider chart)
                const angles = [-Math.PI / 2, -Math.PI / 2 + 0.4 * Math.PI, -Math.PI / 2 + 0.8 * Math.PI, -Math.PI / 2 + 1.2 * Math.PI, -Math.PI / 2 + 1.6 * Math.PI];
                const scores = [
                    (verdict.logic || 88) / 100,
                    (verdict.resilience || 84) / 100,
                    (verdict.empathy || 90) / 100,
                    (verdict.leadership || 86) / 100,
                    (verdict.adaptability || 80) / 100
                ];

                const points = scores.map((s, i) => {
                    const r = s * 45;
                    const x = Math.round(60 + r * Math.cos(angles[i]));
                    const y = Math.round(60 + r * Math.sin(angles[i]));
                    const dot = document.getElementById('radarDot' + i);
                    if (dot) {
                        dot.setAttribute('cx', x);
                        dot.setAttribute('cy', y);
                    }
                    return `${x},${y}`;
                }).join(' ');

                const poly = document.getElementById('verdictRadarPolygon');
                if (poly) poly.setAttribute('points', points);

                // 4. Суперсили
                if (Array.isArray(verdict.superpowers) && verdict.superpowers.length > 0) {
                    const ul = document.getElementById('listSuperpowers');
                    if (ul) {
                        ul.innerHTML = verdict.superpowers.map(p => `
                            <li class="quadrant-item">
                                <span class="quadrant-bullet" style="background: #059669;"></span>
                                <span>${p}</span>
                            </li>
                        `).join('');
                    }
                }

                // 5. Точки росту
                if (Array.isArray(verdict.growthZones) && verdict.growthZones.length > 0) {
                    const ul = document.getElementById('listGrowthZones');
                    if (ul) {
                        ul.innerHTML = verdict.growthZones.map(z => `
                            <li class="quadrant-item">
                                <span class="quadrant-bullet" style="background: #d97706;"></span>
                                <span>${z}</span>
                            </li>
                        `).join('');
                    }
                }

                // 6. Рекомендовані ролі
                if (Array.isArray(verdict.recommendedRoles) && verdict.recommendedRoles.length > 0) {
                    const ul = document.getElementById('listRoles');
                    if (ul) {
                        ul.innerHTML = verdict.recommendedRoles.map(r => `
                            <li class="quadrant-item">
                                <span class="quadrant-bullet" style="background: #2563eb;"></span>
                                <span><strong>${r}</strong></span>
                            </li>
                        `).join('');
                    }
                }

                // 7. Точність вердикту та інсайт форми радара
                let accuracy = verdict.accuracy;
                if (!accuracy) {
                    const baseScore = verdict.score || 91;
                    accuracy = (94.0 + ((baseScore * 3) % 45) / 10).toFixed(1);
                }
                const accEl = document.getElementById('verdictAccuracyVal');
                if (accEl) accEl.textContent = accuracy + '%';

                const badgeTextEl = document.getElementById('verdictBadgeText');
                if (badgeTextEl) {
                    badgeTextEl.innerHTML = `ПРОФІЛЮВАННЯ ЗАВЕРШЕНО • ТОЧНІСТЬ ВЕРДИКТУ <span id="verdictAccuracyVal">${accuracy}%</span>`;
                }

                if (verdict.radarInsight) {
                    const rEl = document.getElementById('verdictRadarInsight');
                    if (rEl) rEl.textContent = verdict.radarInsight;
                }

                // 8. Порівняння з медіаною по галузі
                const avg = Math.round(((verdict.logic || 88) + (verdict.resilience || 84) + (verdict.empathy || 90) + (verdict.leadership || 86) + (verdict.adaptability || 80)) / 5);
                const median = 68;
                const diff = avg - median;
                const deltaEl = document.getElementById('industryDeltaVal');
                if (deltaEl) {
                    if (diff >= 0) {
                        deltaEl.style.color = '#059669';
                        deltaEl.textContent = `▲ +${diff}% вище середнього`;
                    } else {
                        deltaEl.style.color = '#d97706';
                        deltaEl.textContent = `▼ ${diff}% нижче середнього`;
                    }
                }

                // 9. Командна синергія
                if (verdict.teamSynergy) {
                    if (verdict.teamSynergy.idealPartner) {
                        const el = document.getElementById('synergyPartner');
                        if (el) el.innerHTML = verdict.teamSynergy.idealPartner;
                    }
                    if (verdict.teamSynergy.creativeUnion) {
                        const el = document.getElementById('synergyCreative');
                        if (el) el.innerHTML = verdict.teamSynergy.creativeUnion;
                    }
                    if (verdict.teamSynergy.frictionZone) {
                        const el = document.getElementById('synergyFriction');
                        if (el) el.innerHTML = verdict.teamSynergy.frictionZone;
                    }
                }

            } catch (e) {
                console.error('Error hydrating AI verdict:', e);
            }

            // Оновлення нікнейму користувача в шапці
            try {
                const userRaw = localStorage.getItem('smarttest_user');
                if (userRaw) {
                    const user = JSON.parse(userRaw);
                    const btn = document.querySelector('.btn-login span');
                    if (btn && user.nickname) btn.textContent = '@@' + user.nickname;
                }
            } catch (e) {}
        });

        function shareResult() {
            const archetype = document.getElementById('verdictArchetypeName')?.innerText || 'AI-архетип';
            const score = document.getElementById('verdictArchetypeScore')?.innerText || '';
            const text = `Мій багатовимірний результат у SmartTest: ${archetype} (${score}). Пройди тестування: ${window.location.origin}`;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    alert('✓ Результат скопійовано в буфер обміну:\n\n' + text);
                }).catch(() => {
                    prompt('Скопіюйте посилання на результат:', text);
                });
            } else {
                prompt('Скопіюйте посилання на результат:', text);
            }
        }
    </script>

