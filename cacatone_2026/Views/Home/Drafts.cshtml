    <!-- Скрипти кабінету: перемикання вкладок, робота з localStorage, копіювання посилань -->
    <script>
        function switchCabinetTab(tabName) {
            const btnDrafts = document.getElementById('tabBtnDrafts');
            const btnPublished = document.getElementById('tabBtnPublished');
            const btnAll = document.getElementById('tabBtnAll');

            const viewDrafts = document.getElementById('viewDrafts');
            const viewPublished = document.getElementById('viewPublished');
            const viewAll = document.getElementById('viewAll');

            // Стилі для неактивної кнопки
            const inactiveStyle = 'background: #ffffff; border: 1.5px solid #e2e8f0; color: #64748b; padding: 8px 18px; border-radius: 9999px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: none; transition: all 0.2s;';
            // Стилі для активної кнопки
            const activeStyle = 'background: #fbf2ff; border: 1.5px solid #8a00c2; color: #8a00c2; padding: 8px 18px; border-radius: 9999px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(138,0,194,0.12); transition: all 0.2s;';

            btnDrafts.style.cssText = inactiveStyle;
            btnPublished.style.cssText = inactiveStyle;
            btnAll.style.cssText = inactiveStyle;

            viewDrafts.style.display = 'none';
            viewPublished.style.display = 'none';
            viewAll.style.display = 'none';

            if (tabName === 'published') {
                btnPublished.style.cssText = activeStyle;
                viewPublished.style.display = 'flex';
                history.replaceState(null, null, '#published');
            } else if (tabName === 'all') {
                btnAll.style.cssText = activeStyle;
                viewAll.style.display = 'flex';
                history.replaceState(null, null, '#all');
            } else {
                btnDrafts.style.cssText = activeStyle;
                viewDrafts.style.display = 'flex';
                history.replaceState(null, null, '#drafts');
            }
        }

        function copyTestLink(slug) {
            const path = '/question';
            const url = window.location.origin + window.location.pathname.replace(/[^\/]+$/, path) + '?matrix=' + slug;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(() => {
                    alert('✓ Посилання для проходження тесту скопійовано:\n' + url);
                }).catch(() => {
                    alert('Посилання на тест:\n' + url);
                });
            } else {
                alert('Посилання на тест:\n' + url);
            }
        }

        function filterAllRecords() {
            const query = document.getElementById('filterAllInput').value.toLowerCase().trim();
            const items = document.querySelectorAll('.all-record-item');
            items.forEach(el => {
                const title = (el.getAttribute('data-title') || '').toLowerCase();
                const text = el.innerText.toLowerCase();
                if (!query || title.includes(query) || text.includes(query)) {
                    el.style.display = 'block';
                } else {
                    el.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Перевірка хешу в URL
            const hash = window.location.hash;
            if (hash === '#published') {
                switchCabinetTab('published');
            } else if (hash === '#all') {
                switchCabinetTab('all');
            } else {
                switchCabinetTab('drafts');
            }

            // Зчитування localStorage для чернетки
            try {
                const savedMatrix = localStorage.getItem('smarttest_custom_matrix');
                const savedDraft = localStorage.getItem('smarttest_draft');
                
                if (savedMatrix || savedDraft) {
                    const matrix = savedMatrix ? JSON.parse(savedMatrix) : null;
                    const draft = savedDraft ? JSON.parse(savedDraft) : null;

                    const title = (matrix && matrix.title) || (draft && draft.title);
                    if (title) {
                        const titleEl = document.getElementById('draftTitleDisplay');
                        if (titleEl) titleEl.textContent = title;
                    }

                    if (matrix && matrix.description) {
                        const descEl = document.getElementById('draftDescDisplay');
                        if (descEl) descEl.textContent = matrix.description;
                    }

                    if (draft && draft.savedAt) {
                        const timeEl = document.getElementById('draftTimeLabel');
                        if (timeEl) timeEl.textContent = `Сьогодні о ${draft.savedAt}`;
                    }

                    const casesCount = (matrix && Array.isArray(matrix.cases)) ? matrix.cases.length : (draft ? draft.casesCount : 4);
                    if (casesCount) {
                        const countEl = document.getElementById('draftCasesCountDisplay');
                        if (countEl) countEl.textContent = `${casesCount} кейси з 8 запланованих`;
                        
                        const pct = Math.min(100, Math.round((casesCount / 8) * 100));
                        const pctEl = document.getElementById('draftProgressPercent');
                        const barEl = document.getElementById('draftProgressBar');
                        if (pctEl) pctEl.textContent = `${pct}%`;
                        if (barEl) barEl.style.width = `${pct}%`;
                    }

                    // Динамічний рендеринг бейджів осей спайдер-діаграми
                    if (matrix && Array.isArray(matrix.axes) && matrix.axes.length > 0) {
                        const pillsContainer = document.getElementById('draftAxesPillsList');
                        if (pillsContainer) {
                            const palettes = [
                                { bg: '#fbf2ff', border: '#e4b6ff', color: '#8a00c2' },
                                { bg: '#f0f5ff', border: '#dbeafe', color: '#2563eb' },
                                { bg: '#fffaf0', border: '#fef3c7', color: '#d97706' },
                                { bg: '#f0faf4', border: '#d1fae5', color: '#059669' },
                                { bg: '#fff2f4', border: '#ffe4e6', color: '#e11d48' }
                            ];
                            pillsContainer.innerHTML = matrix.axes.map((ax, idx) => {
                                const pal = palettes[idx % palettes.length];
                                return `<span class="badge-pill-accent" style="background: ${pal.bg}; color: ${pal.color}; border: 1px solid ${pal.border};">${ax}</span>`;
                            }).join(' ');
                        }
                    }
                } else {
                    // Якщо чернеток взагалі немає
                    const badge = document.getElementById('tabDraftsBadge');
                    if (badge) badge.textContent = '0';
                }
            } catch (e) {
                console.log('Помилка зчитування localStorage:', e);
            }

            // Оновлення нікнейму користувача в шапці
            try {
                const userRaw = localStorage.getItem('smarttest_user');
                if (userRaw) {
                    const user = JSON.parse(userRaw);
                    const btn = document.querySelector('.btn-login span');
                    if (btn && user.nickname) btn.textContent = '@@' + user.nickname;
                }
            } catch (e) {}
        });

        function deleteDraft() {
            if (confirm('Ви впевнені, що бажаєте видалити цю чернетку?')) {
                localStorage.removeItem('smarttest_draft');
                localStorage.removeItem('smarttest_custom_matrix');
                const card = document.querySelector('.draft-card');
                if (card) {
                    card.style.opacity = '0.4';
                    setTimeout(() => {
                        card.innerHTML = `
                            <div style="text-align: center; padding: 40px 20px; color: #64748b;">
                                <div style="font-size: 32px; margin-bottom: 12px;">🗑️</div>
                                <h3 style="font-size: 18px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Чернетку успішно видалено</h3>
                                <p style="font-size: 14px; margin-bottom: 20px;">У вас немає активних збережених чернеток.</p>
                                <a href="/create" class="btn-primary-cta" style="display: inline-flex; text-decoration: none;">+ Створити нову матрицю</a>
                            </div>
                        `;
                        card.style.opacity = '1';
                        card.style.border = '1.5px dashed #cbd5e1';
                        const badge = document.getElementById('tabDraftsBadge');
                        if (badge) badge.textContent = '0';
                    }, 300);
                }
            }
        }
    </script>

